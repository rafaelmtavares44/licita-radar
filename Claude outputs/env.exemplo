# Copie para .env e ajuste. O .env nunca vai para o git.

# --- banco ---
# Este é o Postgres que o docker compose sobe: usuário e senha são
# 'licita', e ele não tem relação com nenhum Postgres que você já tenha
# instalado na máquina.
#
# 127.0.0.1 e não 'localhost': no Windows, 'localhost' resolve para IPv6
# (::1) antes de IPv4, e o Docker Desktop costuma publicar a porta só no
# IPv4 — a conexão então falha sem explicação óbvia.
LR_DATABASE_URL=postgresql://licita:licita@127.0.0.1:5432/licita_radar

# Se a porta 5432 já estiver ocupada por outro Postgres, troque as duas
# linhas para 5433 (ou qualquer porta livre) e suba o compose de novo.
LR_DB_PORT=5432

# Quanto esperar pelo banco antes de desistir com uma mensagem legível.
LR_DATABASE_TIMEOUT_S=5

# --- PNCP ---
# A API de consulta é pública e não exige chave. Estes valores só controlam
# como somos educados com o servidor deles.
LR_PNCP_BASE_URL=https://pncp.gov.br/api/consulta
LR_PNCP_TIMEOUT_S=30
LR_PNCP_MAX_TENTATIVAS=5
LR_PNCP_CONCORRENCIA=2

# O PNCP tem limite de requisições (não documentado, mas real). Estes dois
# controlam o espaçamento entre chamadas, que dobra sozinho a cada 429.
LR_PNCP_INTERVALO_MIN_S=0.2
LR_PNCP_INTERVALO_MAX_S=8
LR_PNCP_TAMANHO_PAGINA=100

# Guarda em disco as respostas da API durante o desenvolvimento,
# para não repetir chamada a cada execução. Deixe false em produção.
LR_PNCP_CACHE_LOCAL=false

# --- LLM (opcional) ---
# Sem isto, as justificativas são heurísticas e o projeto roda igual.
# Protocolo da OpenAI, então qualquer um destes serve:
#
#   Gemini (recomendado):    LR_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     chave em aistudio.google.com/apikey
#                            LR_LLM_MODELO=gemini-2.5-flash
#   Ollama (local, grátis):  LR_LLM_BASE_URL=http://127.0.0.1:11434/v1
#                            LR_LLM_MODELO=llama3.2
#   Groq (rápido, grátis):   LR_LLM_BASE_URL=https://api.groq.com/openai/v1
#     modelos mudam: se der 404, o `licita-radar doctor` lista os atuais
#                            LR_LLM_MODELO=openai/gpt-oss-120b
#   OpenAI:                  LR_LLM_BASE_URL=https://api.openai.com/v1
#                            LR_LLM_MODELO=gpt-4o-mini
#
# Por que Gemini e não Groq, para ESTE projeto: um edital ocupa uns 7 mil
# tokens de prompt, e o teto por minuto do gpt-oss-120b na camada gratuita
# da Groq é 8 mil. Ou seja, UMA análise já consome o minuto inteiro — o
# 429 não é acidente, é aritmética. O free tier do Gemini trabalha na casa
# das centenas de milhares de tokens por minuto, e a mesma análise deixa
# de encostar no limite. A troca é de duas linhas: o protocolo é o mesmo.
#
# LR_LLM_BASE_URL=
# LR_LLM_MODELO=
# LR_LLM_API_KEY=

# --- análise do edital (M4) ---
# Os arquivos do edital vivem noutra API do PNCP, a de integração — a de
# consultas só devolve os metadados da contratação.
# LR_PNCP_INTEGRACAO_BASE_URL=https://pncp.gov.br/api/pncp

# Onde os PDFs baixados ficam. Já está no .gitignore; edital publicado não
# muda, então o que já foi baixado é reaproveitado.
# LR_DOCUMENTOS_DIR=.editais

# A rota que lista os anexos é lenta: uma medição real levou 58 segundos
# para devolver dez linhas de JSON. Não é a sua rede — é o PNCP.
# LR_PNCP_ARQUIVOS_TIMEOUT_S=120

# Quantos anexos entram na análise, em ordem de relevância (edital, termo
# de referência, depois o resto). Três cobre a maioria esmagadora.
# LR_ANALISE_MAX_DOCUMENTOS=3

# Quanto texto de edital vai para o modelo por análise. Acima disso, o
# recorte por assunto escolhe as seções que respondem às perguntas.
# LR_ANALISE_ORCAMENTO_CARACTERES=24000

# --- alerta no Telegram (opcional) ---
# Sem isto, os alertas ficam só no log e o projeto roda igual.
#
#   1. no Telegram, fale com o @BotFather e mande /newbot
#   2. cole o token aqui
#   3. mande /start para o SEU bot (sem isso ele não pode te escrever)
#   4. rode: licita-radar alertar --descobrir
#
# LR_TELEGRAM_TOKEN=123456789:AA...
# LR_TELEGRAM_CHAT_ID=

# Endereço do painel. Com ele, o alerta traz um link clicável em vez de um
# comando para digitar no computador que você não está usando.
# LR_PAINEL_URL=http://192.168.0.10:8000

# --- perfil ---
LR_PERFIL_PATH=perfil.yaml

# --- observabilidade ---
LR_LOG_LEVEL=INFO
